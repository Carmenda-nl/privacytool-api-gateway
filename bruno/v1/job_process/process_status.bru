meta {
  name: process_status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/jobs/{{jobId}}/process/
  body: none
  auth: none
}

headers {
  Accept-Language: {{language}}
}

docs {
  Returns the current job status (and a coarse 0/100 progress).

  For live progress (percentage, current stage, processed rows), use the SSE
  progress stream at `GET /api/v2/jobs/{jobId}/progress/` instead.
}
